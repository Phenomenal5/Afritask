{
  "name": "server",
  "version": "1.0.0",
  "main": "./dist/server.js",
  "type": "module",
  "scripts": {
    "dev": "prisma generate && tsx watch --env-file=.env ./src/server.ts",
    "build": "prisma generate && tsc",
    "typecheck": "prisma generate && tsc --noEmit",
    "start": "node ./dist/server.js",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:import-mongo": "tsx --env-file=.env ./src/scripts/importFromMongo.ts",
    "operator:grant": "tsx --env-file=.env ./src/scripts/grantOperator.ts",
    "seed:superadmin": "tsx --env-file=.env ./src/scripts/seedSuperadmin.ts",
    "test": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --runInBand",
    "test:unit": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --runInBand tests/unit",
    "test:integration": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --runInBand tests/integration",
    "test:api": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --runInBand tests/api",
    "test:e2e": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --runInBand tests/e2e",
    "test:security": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --runInBand tests/security && npm audit --omit=dev --audit-level=high",
    "test:coverage": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --runInBand --coverage",
    "test:load": "tsx tests/load/runLoadTest.ts",
    "typecheck:tests": "tsc -p tsconfig.test.json"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@getbrevo/brevo": "^5.0.4",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "bcrypt": "^6.0.0",
    "bullmq": "^6.3.12",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.2.0",
    "ioredis": "^5.11.1",
    "mongodb": "^6.21.0",
    "morgan": "^1.11.0",
    "multer": "^2.2.0",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "pg": "^8.23.1",
    "swagger-ui-express": "^5.0.1",
    "validator": "^13.15.35",
    "web-push": "^3.6.7",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@types/autocannon": "^7.12.7",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.20.5",
    "@types/passport": "^1.0.17",
    "@types/passport-google-oauth20": "^2.0.17",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/validator": "^13.15.10",
    "@types/web-push": "^3.6.4",
    "autocannon": "^8.0.0",
    "cross-env": "^7.0.3",
    "jest": "^30.5.2",
    "prisma": "^7.10.0",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.14",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.2",
    "mysql2": "^3.24.5"
  }
}
