# Copy to .env and fill in. Keep in sync with src/config/env.ts.
# (required) = the server refuses to boot without it.

# ─── Server ─────────────────────
NODE_ENV=development
# (required) The port the API listens on. The client's API_URL / NEXT_PUBLIC_API_URL must
# point here (Docker overrides it to 3000 to match its port mapping).
PORT=5000
# Swagger UI at /api/docs — on by default except in production. on | off
API_DOCS=
# Build/release identifier shown by GET /api/health (e.g. the git SHA). Optional.
RELEASE_VERSION=
# (required) The customer app's full address: CORS, OAuth redirects and links in emails.
# No fallback: set it in every environment (production: https://<your-client-domain>).
CLIENT_URL=http://localhost:3001
# The admin console's address, when it's hosted on its own domain (allowed by CORS next to
# CLIENT_URL). Its sign-in cookie is SameSite=Strict, so host it on the same site as the
# API (e.g. admin.example.com with api.example.com) or behind a same-origin /api proxy.
# Local dev doesn't need it: Vite proxies /api to the API.
ADMIN_URL=

# ─── Data stores ─────────────────────
# (required) PostgreSQL. For Neon use the POOLED url ("-pooler" host) here.
# Use a Neon development branch locally (there's no Postgres container in docker-compose).
DATABASE_URL=postgresql://<user>:<password>@<host>/<db>?sslmode=verify-full
# Migrations (`npm run db:migrate` / `db:deploy`) need a DIRECT connection — for Neon,
# the same url without "-pooler". If unset, migrations fall back to DATABASE_URL.
DIRECT_DATABASE_URL=
# Only for the one-off `npm run db:import-mongo` (copies the old MongoDB data into Postgres).
MONGO_URL=
# (required) BullMQ reminder queue. `docker compose up -d redis`, or a hosted Redis URL.
REDIS_URL=redis://localhost:6379

# ─── Auth ─────────────────────
# Logins use two httpOnly cookies: a short access token (signed JWT) and a refresh token
# stored (hashed) in the database, revoked on logout. Nothing is kept in localStorage.
# (required) at least 32 random characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
ACCESS_TOKEN_SECRET=
# (required) How many minutes an access token lasts. The browser refreshes it quietly.
ACCESS_TOKEN_TTL_MINUTES=15
# (required) How many days a login lasts (the refresh token). Plain numbers only, not "7d".
REFRESH_TOKEN_TTL_DAYS=7
# Production only: how many reverse proxies sit in front of Express (the client's /api
# rewrite counts as one). Gets real client IPs for rate limiting.
TRUST_PROXY_HOPS=1
# Link lifetimes in milliseconds (defaults: 1 hour / 15 minutes).
VERIFY_EMAIL_TOKEN_EXPIRES_MS=3600000
RESET_PASSWORD_TOKEN_EXPIRES_MS=900000

# Admin console (Platform Superadmin). 32 random bytes (64 hex chars) that encrypt operators'
# MFA secrets at rest. Without it the console answers "not configured". Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# NOTE: changing it invalidates every enrolled authenticator (reset with operator:grant --reset-mfa).
OPERATOR_MFA_KEY=

# Web push (optional). Set all three or none (the server refuses half a setup).
# Without them, the push setting reports "not configured"; live
# updates (SSE), the notification sound and emails still work. Generate with:
#   npx web-push generate-vapid-keys
# NOTE: changing the pair invalidates every browser's push subscription (they re-subscribe).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# A contact for the push services: mailto:you@example.com or an https URL.
VAPID_SUBJECT=

# Optional: the first admin console account. On boot, if this email has never had
# operator access, the server creates the account (or grants access to an existing one)
# and records it in the audit trail. It never overwrites a password or re-grants a revoked
# operator. The first console sign-in requires setting up an authenticator (MFA).
# To seed it without starting the server: npm run seed:superadmin
# (production: node dist/scripts/seedSuperadmin.js).
# Use a long random password, and remove these once the account exists.
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=
SUPERADMIN_NAME=

# Google sign-in (optional). Set all three or none (the server refuses half a setup).
# GOOGLE_CALLBACK_URL must be a full address ending in /api/v1/auth/google/callback, https
# in production, and EXACTLY one of the "Authorized redirect URIs" of this client in
# Google Cloud Console, or Google answers redirect_uri_mismatch.
# Local: http://localhost:<PORT>/api/v1/auth/google/callback
# Production: https://<your-client-domain>/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=

# ─── Email (Brevo) ─────────────────────
# (required)
BREVO_API_KEY=your-brevo-api-key
# (required) Must be a verified sender in Brevo.
EMAIL_FROM_ADDRESS=verified-sender@example.com
EMAIL_FROM_NAME=AfriTask
# Optional logo shown at the top of every email.
EMAIL_LOGO_URL=
