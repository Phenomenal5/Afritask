# Copy to .env and fill in. Keep in sync with src/config/env.ts.
# (required) = the server refuses to boot without it.

# ─── Server ─────────────────────
NODE_ENV=development
# Defaults to 5000, which matches the client's NEXT_PUBLIC_API_URL fallback.
PORT=5000
# Frontend origin: CORS, OAuth redirects and links inside emails.
# Defaults to http://localhost:3001 in dev, https://afritask.netlify.app in production.
CLIENT_URL=http://localhost:3001

# ─── Data stores ─────────────────────
# (required)
MONGO_URL=mongodb+srv://<user>:<password>@<cluster>/<db>
# (required) BullMQ reminder queue. `docker compose up -d redis`, or a hosted Redis URL.
REDIS_URL=redis://localhost:6379

# ─── Auth ─────────────────────
# (required) Long random string, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
# Link lifetimes in milliseconds (defaults: 1 hour / 15 minutes).
VERIFY_EMAIL_TOKEN_EXPIRES_MS=3600000
RESET_PASSWORD_TOKEN_EXPIRES_MS=900000

# Google OAuth is optional — leave blank and /api/auth/google answers "not configured".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# ─── Email (Brevo) ─────────────────────
# (required)
BREVO_API_KEY=your-brevo-api-key
# (required) Must be a verified sender in Brevo.
EMAIL_FROM_ADDRESS=verified-sender@example.com
EMAIL_FROM_NAME=AfriTask
# Optional logo shown at the top of every email.
EMAIL_LOGO_URL=
