// ─── Afritask database schema (PostgreSQL) ─────────────────────
// Follows the Database Design doc; tables arrive feature by feature.
// Apply changes with `npm run db:migrate -- --name <change>`.

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  // partialIndexes: lets @@unique(..., where: raw(...)) express "one active owner per workspace".
  previewFeatures = ["partialIndexes"]
}

// Connection URL lives in prisma.config.ts (Prisma 7 no longer reads it here).
datasource db {
  provider = "postgresql"
}

enum Role {
  user
  admin
}

enum AuthProvider {
  local
  google
}

// Fixed V1 statuses (PRD FR06). The API still accepts legacy "pending" (→ todo) and
// "in progress" / "in-progress" (→ in_progress) from older clients.
enum TaskStatus {
  todo
  in_progress
  in_review
  completed
}

enum TaskPriority {
  low
  medium
  high
  urgent
}

// How a deadline was set (PRD §9): a calendar date resolves to 23:59 on that date in the
// chosen timezone; a date-and-time is an exact instant. Kept so the UI can show the
// intent ("Dec 1") instead of a converted clock time.
enum DueKind {
  date
  datetime
}

// Roles are per workspace: the same person can be Admin in one and Member in another.
// One reminder per task (SRS SR10): when, relative to the deadline. Null = no reminder.
// For a date-only deadline the anchor is 09:00 on the due date in its timezone (a 23:59
// deadline shouldn't mean a midnight email); for an exact time it's the due instant.
enum ReminderOffset {
  at_due
  one_hour
  one_day
  three_days
  one_week
}

enum WorkspaceRole {
  owner
  admin
  member
}

enum MembershipStatus {
  active
  // Left or removed. The row stays so history keeps its attribution (SRS SR04).
  removed
}

enum ProjectState {
  active
  on_hold
  completed
  // Read-only until restored; reminders for its tasks pause (PRD FR05).
  archived
}

// "Expired" isn't stored — it's derived from expiresAt, so it can never drift.
enum InvitationStatus {
  pending
  accepted
  declined
  revoked
}

// Email delivery state, shown to managers so a failed send can be resent (PRD FR03).
enum InvitationDelivery {
  pending
  sent
  failed
}

enum AccountTokenPurpose {
  verify_email
  reset_password
  // Short-lived code that hands a finished Google sign-in from the API's redirect to the client.
  oauth_exchange
}

model User {
  id            String       @id @default(uuid(7)) @db.Uuid
  name          String
  email         String       @unique
  age           Int?
  photo         String?
  // Null for Google-only accounts. Never returned by default — see the global omit in config/prisma.ts.
  password      String?
  // NOTE: legacy customer role from Mongo. Does NOT grant platform Superadmin (that's a separate grant later).
  role          Role         @default(user)
  provider      AuthProvider @default(local)
  providerId    String?      @unique
  isVerified    Boolean      @default(false)
  // IANA zone, e.g. "Africa/Lagos". Detected from the device at signup, editable in profile.
  timezone      String       @default("UTC")
  // Platform suspension (SRS SR17): set by an operator with a reason. Ends every session,
  // blocks sign-in and silences notifications; ownership and assignments are untouched.
  suspendedAt   DateTime?    @db.Timestamptz(3)
  suspendReason String?
  // Terms of Service + Privacy Policy acceptance. termsVersion is the version they agreed to
  // (config/terms.ts); when it's older than the current one they're asked again.
  termsAcceptedAt DateTime?  @db.Timestamptz(3)
  termsVersion    String?
  // Source Mongo _id, so the import script can be re-run without duplicating rows.
  legacyMongoId String?      @unique
  createdAt     DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime     @updatedAt @db.Timestamptz(3)

  createdTasks       Task[]            @relation("TaskCreator")
  memberships        Membership[]
  sentInvites        Invitation[]      @relation("InvitationInviter")
  projects           Project[]         @relation("ProjectCreator")
  sessions           Session[]
  accountTokens      AccountToken[]
  activities         Activity[]        @relation("ActivityActor")
  comments           Comment[]         @relation("CommentAuthor")
  deletedComments    Comment[]         @relation("CommentDeleter")
  notifications      Notification[]    @relation("NotificationRecipient")
  actedNotifications Notification[]    @relation("NotificationActor")
  emailDeliveries    EmailDelivery[]   @relation("EmailDeliveryRecipient")
  platformGrant      PlatformGrant?
  adminAuditEntries  AdminAuditEntry[] @relation("AdminAuditActor")
  deletedWorkspaces  Workspace[]       @relation("WorkspaceDeleter")
}

// Customer sessions (the web app) and operator sessions (the admin console) live in one
// table but are never interchangeable: each side only accepts its own kind (SRS SR16).
enum SessionKind {
  customer
  operator
}

// A signed-in browser. The cookie holds a random secret; only its SHA-256 hash is stored,
// so a database leak can't be replayed as a login. Revoking = setting revokedAt.
// A customer session is the REFRESH TOKEN (secretHash = its hash); access tokens are
// short-lived JWTs that name it. Operator sessions use the secret directly (8h, MFA).
model Session {
  id            String      @id @default(uuid(7)) @db.Uuid
  userId        String      @db.Uuid
  secretHash    String      @unique
  // The refresh token this one replaced, accepted for a minute after rotation so two
  // tabs refreshing at once don't sign each other out.
  previousSecretHash String?   @unique
  rotatedAt          DateTime? @db.Timestamptz(3)
  expiresAt     DateTime    @db.Timestamptz(3)
  revokedAt     DateTime?   @db.Timestamptz(3)
  userAgent     String?
  kind          SessionKind @default(customer)
  // Operator sessions only: set once the MFA code is verified. Until then the session can
  // do nothing but complete MFA.
  mfaVerifiedAt DateTime?   @db.Timestamptz(3)
  createdAt     DateTime    @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Single-use links/codes (email verification, password reset, OAuth hand-off).
// Raw token goes out by email/redirect; only its hash is stored. usedAt marks it consumed.
model AccountToken {
  id        String              @id @default(uuid(7)) @db.Uuid
  userId    String              @db.Uuid
  purpose   AccountTokenPurpose
  tokenHash String              @unique
  expiresAt DateTime            @db.Timestamptz(3)
  usedAt    DateTime?           @db.Timestamptz(3)
  createdAt DateTime            @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
}

// The boundary for shared work. Personal and team workspaces are the same model;
// a personal one simply has a single member (PRD §1).
model Workspace {
  id            String    @id @default(uuid(7)) @db.Uuid
  name          String
  // Soft delete (Owner action): set when other people had already left records here, so
  // their work is kept but nobody can open the workspace any more. A workspace with only
  // the Owner's own records is deleted outright instead.
  deletedAt     DateTime? @db.Timestamptz(3)
  deletedById   String?   @db.Uuid
  // Platform suspension (SRS SR17): members can't read, write or join; reminders pause.
  // Independent of the Owner's soft delete above.
  suspendedAt   DateTime? @db.Timestamptz(3)
  suspendReason String?
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @db.Timestamptz(3)

  memberships   Membership[]
  invitations   Invitation[]
  projects      Project[]
  labels        Label[]
  tasks         Task[]
  activities    Activity[]
  comments      Comment[]
  notifications Notification[]
  deletedBy     User?          @relation("WorkspaceDeleter", fields: [deletedById], references: [id], onDelete: SetNull)
}

// Workspace-scoped tags for tasks (PRD FR07). Owners/Admins manage them; anyone who can
// edit a task can apply existing ones. Deleting a label removes it from tasks, never the tasks.
model Label {
  id          String   @id @default(uuid(7)) @db.Uuid
  workspaceId String   @db.Uuid
  // 1–40 characters; unique per workspace ignoring case (enforced in the controller).
  name        String
  color       String   @default("gray")
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  workspace Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  tasks     TaskLabel[]

  @@unique([workspaceId, name])
}

model TaskLabel {
  taskId    String   @db.Uuid
  labelId   String   @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  task  Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  label Label @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([taskId, labelId])
  @@index([labelId])
}

// A group of related tasks inside one workspace. All projects are visible to every active
// member in V1; only Owners/Admins manage them (PRD §8). Projects are archived, not deleted.
model Project {
  id          String        @id @default(uuid(7)) @db.Uuid
  workspaceId String        @db.Uuid
  name        String
  description String        @default("")
  state       ProjectState  @default(active)
  // The state before archiving, so "restore" returns it there instead of always to Active.
  priorState  ProjectState?
  createdById String        @db.Uuid
  createdAt   DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime      @updatedAt @db.Timestamptz(3)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User      @relation("ProjectCreator", fields: [createdById], references: [id], onDelete: Restrict)
  tasks     Task[]

  @@index([workspaceId, state])
}

// A pending offer to join a workspace by email (SRS SR03). It grants NOTHING until a
// verified account with the same email explicitly accepts it; acceptance creates the
// Membership. The emailed link carries a raw token — only its SHA-256 hash is stored.
model Invitation {
  id             String             @id @default(uuid(7)) @db.Uuid
  workspaceId    String             @db.Uuid
  // Stored lower-cased; matched case-insensitively against the account email.
  email          String
  // admin or member only — ownership is never granted by invitation.
  role           WorkspaceRole
  inviterId      String             @db.Uuid
  tokenHash      String             @unique
  expiresAt      DateTime           @db.Timestamptz(3)
  status         InvitationStatus   @default(pending)
  deliveryStatus InvitationDelivery @default(pending)
  respondedAt    DateTime?          @db.Timestamptz(3)
  createdAt      DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime           @updatedAt @db.Timestamptz(3)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  inviter   User      @relation("InvitationInviter", fields: [inviterId], references: [id], onDelete: Restrict)

  // At most one live invitation per email per workspace — "resend" updates it in place.
  @@unique([workspaceId, email], map: "Invitation_one_pending_per_email", where: raw("status = 'pending'"))
  // "Invitations waiting for me" for existing accounts.
  @@index([email, status])
  @@index([workspaceId, status])
}

model Membership {
  id          String           @id @default(uuid(7)) @db.Uuid
  workspaceId String           @db.Uuid
  userId      String           @db.Uuid
  role        WorkspaceRole
  status      MembershipStatus @default(active)
  joinedAt    DateTime         @default(now()) @db.Timestamptz(3)
  removedAt   DateTime?        @db.Timestamptz(3)
  createdAt   DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime         @updatedAt @db.Timestamptz(3)

  workspace     Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignedTasks Task[]           @relation("TaskAssignee")
  mentions      CommentMention[]

  // One row per person per workspace — re-joining reactivates it instead of duplicating.
  @@unique([workspaceId, userId])
  // NOTE: the database itself refuses a second ACTIVE owner. Ownership transfer must
  // demote the old owner before promoting the new one inside one transaction.
  // (It can't enforce "at least one" — the service layer guarantees that.)
  @@unique([workspaceId], map: "Membership_one_active_owner", where: raw("role = 'owner' AND status = 'active'"))
  // "Which workspaces am I in?"
  @@index([userId, status])
}

model Task {
  id                   String          @id @default(uuid(7)) @db.Uuid
  workspaceId          String          @db.Uuid
  // Author of the task. Kept even if they later leave the workspace.
  creatorId            String          @db.Uuid
  // Optional: a quick task can live in the workspace without a project (PRD J1).
  // NOTE: same-workspace is enforced in the task controller — Prisma can't express a
  // composite (projectId, workspaceId) FK on an optional relation with a required column.
  projectId            String?         @db.Uuid
  // Set for a subtask: its top-level parent. ONE level only (PRD FR07) — a subtask's
  // parent is never itself a subtask (enforced in the controller). Subtasks inherit the
  // parent's workspace and project, and are deleted with it.
  parentTaskId         String?         @db.Uuid
  // Zero or one accountable assignee: a MEMBERSHIP (not a user), so assignment is tied to
  // the person's place in this workspace. Cleared when they leave/are removed (open tasks).
  assigneeMembershipId String?         @db.Uuid
  title                String
  description          String          @default("")
  status               TaskStatus      @default(todo)
  priority             TaskPriority    @default(medium)
  // The due instant (UTC). dueKind/dueTimezone keep the original intent (PRD §9).
  dueAt                DateTime?       @db.Timestamptz(3)
  dueKind              DueKind?
  dueTimezone          String?
  // Set on entering Completed, cleared on reopening. Null for legacy completions (unknown time).
  completedAt          DateTime?       @db.Timestamptz(3)
  // Optimistic concurrency: every write must name the version it read (SRS SR06).
  version              Int             @default(1)
  reminderOffset       ReminderOffset?
  // When work is planned to BEGIN ("I'll start this tomorrow"). Optional; never after dueAt.
  // A date-only start means 00:00 that day in startTimezone. Same intent fields as due.
  startAt              DateTime?       @db.Timestamptz(3)
  startKind            DueKind?
  startTimezone        String?
  // Pending "starts tomorrow" reminder (a day before the start, 09:00 for date-only starts),
  // only while the task is still To do. Cleared when the sweep claims it, like remindAt.
  startReminderAt      DateTime?       @db.Timestamptz(3)
  // The schedule (SRS SR10 "schedule versions"): the next instant the reminder sweep should
  // act on, or null when nothing is pending. Recomputed from the due date, reminder choice,
  // status and project state whenever one of those changes — only ever to a FUTURE time —
  // and cleared atomically when the sweep claims it, so each schedule fires at most once.
  remindAt             DateTime?       @db.Timestamptz(3)
  // Pending "now overdue" alert: the due instant while the task is open and due in the future.
  overdueCheckAt       DateTime?       @db.Timestamptz(3)
  // Idempotency key from the client: a repeated create with the same key returns the
  // first task instead of making a duplicate (SRS SR06 acceptance).
  clientRequestId      String?
  legacyMongoId        String?         @unique
  createdAt            DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime        @updatedAt @db.Timestamptz(3)

  workspace Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  // Restrict: deleting a user must never silently delete shared work (DB design §3).
  creator   User        @relation("TaskCreator", fields: [creatorId], references: [id], onDelete: Restrict)
  project   Project?    @relation(fields: [projectId], references: [id], onDelete: Restrict)
  assignee  Membership? @relation("TaskAssignee", fields: [assigneeMembershipId], references: [id], onDelete: SetNull)
  parent    Task?       @relation("Subtasks", fields: [parentTaskId], references: [id], onDelete: Cascade)
  subtasks  Task[]      @relation("Subtasks")
  labels    TaskLabel[]
  comments  Comment[]

  @@unique([workspaceId, clientRequestId])
  // Every task query is workspace-scoped, newest first.
  @@index([workspaceId, createdAt])
  @@index([creatorId])
  @@index([projectId])
  @@index([parentTaskId])
  // My Tasks: a member's assigned work by status and due date (DB design §3).
  @@index([workspaceId, assigneeMembershipId, status, dueAt])
  @@index([dueAt, status])
  // The reminder sweep: what's due to fire.
  @@index([remindAt])
  @@index([overdueCheckAt])
  @@index([startReminderAt])
}

// Append-only history of who changed what (SRS SR09). Written in the SAME transaction as
// the change it describes, so a rolled-back write never leaves a ghost entry.
// NOTE: no foreign key to the task/project/membership it describes — history must outlive
// a deleted task. A database trigger refuses UPDATE (see the activity migration).
model Activity {
  id          String   @id @default(uuid(7)) @db.Uuid
  workspaceId String   @db.Uuid
  actorId     String   @db.Uuid
  // "task" | "project" | "membership" | "workspace"
  entityType  String
  entityId    String   @db.Uuid
  // Denormalized so a project's feed includes its tasks' events without a join.
  projectId   String?  @db.Uuid
  // e.g. "task.created", "task.updated", "project.archived", "member.removed".
  action      String
  // Field-level before/after values: { status: { from: "todo", to: "completed" } }.
  changes     Json?
  // Snapshot for display (title/name at the time), so a later rename doesn't rewrite history.
  summary     String   @default("")
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  actor     User      @relation("ActivityActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([workspaceId, createdAt])
  @@index([entityType, entityId, createdAt])
  @@index([projectId, createdAt])
}

// A discussion entry on a task or subtask (SRS SR08). Plain text, 1–5,000 characters,
// rendered escaped. Deleting keeps the row (deletedAt + deletedById, body cleared) so the
// thread shows "comment deleted by …" instead of silently losing its shape.
model Comment {
  id          String    @id @default(uuid(7)) @db.Uuid
  taskId      String    @db.Uuid
  workspaceId String    @db.Uuid
  authorId    String    @db.Uuid
  body        String
  // Set on every edit by the author; the UI shows "edited".
  editedAt    DateTime? @db.Timestamptz(3)
  deletedAt   DateTime? @db.Timestamptz(3)
  // The author, or an Owner/Admin moderating (attribution kept per SRS SR08).
  deletedById String?   @db.Uuid
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(3)

  task      Task             @relation(fields: [taskId], references: [id], onDelete: Cascade)
  workspace Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  author    User             @relation("CommentAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  deletedBy User?            @relation("CommentDeleter", fields: [deletedById], references: [id], onDelete: SetNull)
  mentions  CommentMention[]

  // A task's thread, oldest first.
  @@index([taskId, createdAt])
}

// Who a comment mentions. A MEMBERSHIP, so only people in the task's workspace can be
// mentioned. One row per person per comment — repeating "@Ada" twice still mentions once.
model CommentMention {
  commentId    String   @db.Uuid
  membershipId String   @db.Uuid
  createdAt    DateTime @default(now()) @db.Timestamptz(3)

  comment    Comment    @relation(fields: [commentId], references: [id], onDelete: Cascade)
  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@id([commentId, membershipId])
  @@index([membershipId])
}

enum NotificationType {
  // Someone else made you the assignee of a task or subtask.
  task_assigned
  // You were newly mentioned in a comment (once per comment edit event).
  comment_mention
  // A workspace invited your email (you already have an account).
  invitation_received
  // Your task's reminder time arrived.
  task_reminder
  // Your task passed its due time while still open (once per deadline).
  task_overdue
  // A task you planned to start begins tomorrow — time to prepare.
  task_starting
}

enum EmailDeliveryStatus {
  pending
  sent
  // Provider refused or errored. Retried a bounded number of times, then left visible.
  failed
  // Not sent because the work changed (completed, deleted, archived, recipient left).
  suppressed
}

// Ledger of reminder/overdue emails (SRS SR10 / Technical Design "delivery ledger"). The
// unique deliveryKey means a re-run sweep can't send the same reminder twice, and failures
// stay visible (with the last error) for retry and for the operator console.
model EmailDelivery {
  id          String              @id @default(uuid(7)) @db.Uuid
  deliveryKey String              @unique
  // "task_reminder" | "task_overdue"
  kind        String
  recipientId String              @db.Uuid
  taskId      String?             @db.Uuid
  status      EmailDeliveryStatus @default(pending)
  attempts    Int                 @default(0)
  lastError   String?
  sentAt      DateTime?           @db.Timestamptz(3)
  createdAt   DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime            @updatedAt @db.Timestamptz(3)

  recipient User @relation("EmailDeliveryRecipient", fields: [recipientId], references: [id], onDelete: Cascade)

  // Retry pass: failed deliveries by age.
  @@index([status, updatedAt])
}

// One in-app notification for one person (SRS SR10). Written in the SAME transaction as
// the change that caused it, so a committed change never loses its notification and a
// rolled-back one never leaves a stray. Links are re-checked when listed and opened —
// the stored summary is hidden once the recipient can no longer see the item.
model Notification {
  id           String           @id @default(uuid(7)) @db.Uuid
  recipientId  String           @db.Uuid
  // Null for invitations: the recipient isn't a member of that workspace yet.
  workspaceId  String?          @db.Uuid
  actorId      String?          @db.Uuid
  type         NotificationType
  // What it points at. No foreign keys: the notification outlives a deleted task.
  taskId       String?          @db.Uuid
  commentId    String?          @db.Uuid
  invitationId String?          @db.Uuid
  // Snapshot for display (task title / workspace name at the time).
  summary      String           @default("")
  // Idempotency: one logical notification per recipient. Repeating the same event
  // (a retried request, a re-run job) hits this unique key instead of duplicating.
  deliveryKey  String           @unique
  readAt       DateTime?        @db.Timestamptz(3)
  createdAt    DateTime         @default(now()) @db.Timestamptz(3)

  recipient User       @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  actor     User?      @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)
  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  // The bell: my notifications newest first, and my unread count.
  @@index([recipientId, createdAt])
  @@index([recipientId, readAt])
}

// ─── Platform administration (SRS SR16–SR18) ─────────────────────

enum PlatformRole {
  superadmin
}

// Who may operate Afritask. NOTE: created ONLY by the deployment-side script
// (npm run operator:grant) — no API route, signup, invitation or profile update can write
// it. Being an operator grants NO access to workspace content (tasks, comments).
model PlatformGrant {
  id                 String       @id @default(uuid(7)) @db.Uuid
  userId             String       @unique @db.Uuid
  role               PlatformRole @default(superadmin)
  // TOTP secret, AES-256-GCM encrypted with OPERATOR_MFA_KEY. Set when enrolment starts.
  mfaSecretEncrypted String?
  // When the operator first proved a code — enrolment is complete from then on.
  mfaEnabledAt       DateTime?    @db.Timestamptz(3)
  // The last accepted 30-second step: the same code can never be used twice.
  mfaLastUsedStep    Int?
  // Free-text record of who/why, written by the grant script.
  note               String       @default("")
  grantedAt          DateTime     @default(now()) @db.Timestamptz(3)
  revokedAt          DateTime?    @db.Timestamptz(3)
  updatedAt          DateTime     @updatedAt @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Append-only record of operator actions and access (SRS SR18). Like Activity, a database
// trigger refuses UPDATE. Never stores task or comment bodies.
model AdminAuditEntry {
  id         String   @id @default(uuid(7)) @db.Uuid
  // Null for actions taken by a deployment script rather than a signed-in operator.
  actorId    String?  @db.Uuid
  // e.g. "operator.granted", "operator.signed_in", "account.suspended".
  action     String
  // "user" | "workspace" | "delivery" | "operator"
  targetType String?
  targetId   String?  @db.Uuid
  // Required for consequential actions (suspend/restore/retry) — the operator's reason.
  reason     String   @default("")
  metadata   Json?
  ipAddress  String?
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  actor User? @relation("AdminAuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([targetType, targetId, createdAt])
  @@index([actorId, createdAt])
}
