// ─── Afritask database schema (PostgreSQL) ─────────────────────
// Follows the Database Design doc; tables arrive feature by feature.
// Apply changes with `npm run db:migrate -- --name <change>`.

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  // partialIndexes: lets @@unique(..., where: raw(...)) express "one active owner per workspace".
  previewFeatures = ["partialIndexes"]
}

// Connection URL lives in prisma.config.ts (Prisma 7 no longer reads it here).
datasource db {
  provider = "postgresql"
}

enum Role {
  user
  admin
}

enum AuthProvider {
  local
  google
}

enum TaskStatus {
  pending
  // Stored and sent as "in_progress"; the API still accepts the legacy "in progress" / "in-progress".
  in_progress
  completed
}

enum TaskPriority {
  low
  medium
  high
}

// Roles are per workspace: the same person can be Admin in one and Member in another.
enum WorkspaceRole {
  owner
  admin
  member
}

enum MembershipStatus {
  active
  // Left or removed. The row stays so history keeps its attribution (SRS SR04).
  removed
}

enum ProjectState {
  active
  on_hold
  completed
  // Read-only until restored; reminders for its tasks pause (PRD FR05).
  archived
}

// "Expired" isn't stored — it's derived from expiresAt, so it can never drift.
enum InvitationStatus {
  pending
  accepted
  declined
  revoked
}

// Email delivery state, shown to managers so a failed send can be resent (PRD FR03).
enum InvitationDelivery {
  pending
  sent
  failed
}

enum AccountTokenPurpose {
  verify_email
  reset_password
  // Short-lived code that hands a finished Google sign-in from the API's redirect to the client.
  oauth_exchange
}

model User {
  id                   String       @id @default(uuid(7)) @db.Uuid
  name                 String
  email                String       @unique
  age                  Int?
  photo                String?
  // Null for Google-only accounts. Never returned by default — see the global omit in config/prisma.ts.
  password             String?
  // NOTE: legacy customer role from Mongo. Does NOT grant platform Superadmin (that's a separate grant later).
  role                 Role         @default(user)
  provider             AuthProvider @default(local)
  providerId           String?      @unique
  isVerified           Boolean      @default(false)
  // IANA zone, e.g. "Africa/Lagos". Detected from the device at signup, editable in profile.
  timezone             String       @default("UTC")
  // Source Mongo _id, so the import script can be re-run without duplicating rows.
  legacyMongoId        String?      @unique
  createdAt            DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime     @updatedAt @db.Timestamptz(3)

  createdTasks  Task[]       @relation("TaskCreator")
  memberships   Membership[]
  sentInvites   Invitation[] @relation("InvitationInviter")
  projects      Project[]    @relation("ProjectCreator")
  sessions      Session[]
  accountTokens AccountToken[]
}

// A signed-in browser. The cookie holds a random secret; only its SHA-256 hash is stored,
// so a database leak can't be replayed as a login. Revoking = setting revokedAt.
model Session {
  id         String    @id @default(uuid(7)) @db.Uuid
  userId     String    @db.Uuid
  secretHash String    @unique
  expiresAt  DateTime  @db.Timestamptz(3)
  revokedAt  DateTime? @db.Timestamptz(3)
  userAgent  String?
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Single-use links/codes (email verification, password reset, OAuth hand-off).
// Raw token goes out by email/redirect; only its hash is stored. usedAt marks it consumed.
model AccountToken {
  id        String              @id @default(uuid(7)) @db.Uuid
  userId    String              @db.Uuid
  purpose   AccountTokenPurpose
  tokenHash String              @unique
  expiresAt DateTime            @db.Timestamptz(3)
  usedAt    DateTime?           @db.Timestamptz(3)
  createdAt DateTime            @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
}

// The boundary for shared work. Personal and team workspaces are the same model;
// a personal one simply has a single member (PRD §1).
model Workspace {
  id        String   @id @default(uuid(7)) @db.Uuid
  name      String
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  memberships Membership[]
  invitations Invitation[]
  projects    Project[]
  tasks       Task[]
}

// A group of related tasks inside one workspace. All projects are visible to every active
// member in V1; only Owners/Admins manage them (PRD §8). Projects are archived, not deleted.
model Project {
  id          String        @id @default(uuid(7)) @db.Uuid
  workspaceId String        @db.Uuid
  name        String
  description String        @default("")
  state       ProjectState  @default(active)
  // The state before archiving, so "restore" returns it there instead of always to Active.
  priorState  ProjectState?
  createdById String        @db.Uuid
  createdAt   DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime      @updatedAt @db.Timestamptz(3)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User      @relation("ProjectCreator", fields: [createdById], references: [id], onDelete: Restrict)
  tasks     Task[]

  @@index([workspaceId, state])
}

// A pending offer to join a workspace by email (SRS SR03). It grants NOTHING until a
// verified account with the same email explicitly accepts it; acceptance creates the
// Membership. The emailed link carries a raw token — only its SHA-256 hash is stored.
model Invitation {
  id             String             @id @default(uuid(7)) @db.Uuid
  workspaceId    String             @db.Uuid
  // Stored lower-cased; matched case-insensitively against the account email.
  email          String
  // admin or member only — ownership is never granted by invitation.
  role           WorkspaceRole
  inviterId      String             @db.Uuid
  tokenHash      String             @unique
  expiresAt      DateTime           @db.Timestamptz(3)
  status         InvitationStatus   @default(pending)
  deliveryStatus InvitationDelivery @default(pending)
  respondedAt    DateTime?          @db.Timestamptz(3)
  createdAt      DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime           @updatedAt @db.Timestamptz(3)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  inviter   User      @relation("InvitationInviter", fields: [inviterId], references: [id], onDelete: Restrict)

  // At most one live invitation per email per workspace — "resend" updates it in place.
  @@unique([workspaceId, email], map: "Invitation_one_pending_per_email", where: raw("status = 'pending'"))
  // "Invitations waiting for me" for existing accounts.
  @@index([email, status])
  @@index([workspaceId, status])
}

model Membership {
  id          String           @id @default(uuid(7)) @db.Uuid
  workspaceId String           @db.Uuid
  userId      String           @db.Uuid
  role        WorkspaceRole
  status      MembershipStatus @default(active)
  joinedAt    DateTime         @default(now()) @db.Timestamptz(3)
  removedAt   DateTime?        @db.Timestamptz(3)
  createdAt   DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime         @updatedAt @db.Timestamptz(3)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  // One row per person per workspace — re-joining reactivates it instead of duplicating.
  @@unique([workspaceId, userId])
  // NOTE: the database itself refuses a second ACTIVE owner. Ownership transfer must
  // demote the old owner before promoting the new one inside one transaction.
  // (It can't enforce "at least one" — the service layer guarantees that.)
  @@unique([workspaceId], map: "Membership_one_active_owner", where: raw("role = 'owner' AND status = 'active'"))
  // "Which workspaces am I in?"
  @@index([userId, status])
}

model Task {
  id            String       @id @default(uuid(7)) @db.Uuid
  workspaceId   String       @db.Uuid
  // Author of the task. Kept even if they later leave the workspace.
  creatorId     String       @db.Uuid
  // Optional: a quick task can live in the workspace without a project (PRD J1).
  // NOTE: same-workspace is enforced in the task controller — Prisma can't express a
  // composite (projectId, workspaceId) FK on an optional relation with a required column.
  projectId     String?      @db.Uuid
  title         String
  description   String       @default("")
  status        TaskStatus   @default(pending)
  priority      TaskPriority @default(medium)
  deadline      DateTime?    @db.Timestamptz(3)
  legacyMongoId String?      @unique
  createdAt     DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime     @updatedAt @db.Timestamptz(3)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  // Restrict: deleting a user must never silently delete shared work (DB design §3).
  creator   User      @relation("TaskCreator", fields: [creatorId], references: [id], onDelete: Restrict)
  project   Project?  @relation(fields: [projectId], references: [id], onDelete: Restrict)

  // Every task query is workspace-scoped, newest first.
  @@index([workspaceId, createdAt])
  @@index([creatorId])
  @@index([projectId])
  // Daily reminder scan: incomplete tasks by deadline.
  @@index([deadline, status])
}
